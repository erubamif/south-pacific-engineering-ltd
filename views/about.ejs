
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %> | South-Pacific Engineering Ltd</title>

  <meta
    name="description"
    content="Learn about South-Pacific Engineering Ltd and our mission to deliver integrated engineering excellence through innovative, safe, and sustainable solutions."
  >

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include("partials/header") %>

  <main>
    <!-- About Page Banner -->
    <section class="page-banner">
      <div class="container">
        <p class="section-label">About Our Company</p>

        <h1 class="section-title">
          INTEGRATED<br>
          ENGINEERING<br>
          EXCELLENCE.
        </h1>

        <p class="section-description">
          Innovative, safe, and sustainable engineering solutions
          that enhance asset value and operational efficiency.
        </p>
      </div>
    </section>

    <!-- Company Mission -->
    <section class="section intro">
      <div class="container intro-grid">
        <div>
          <p class="section-label">Our Mission</p>

          <h2 class="section-title">
            ENGINEERING<br>
            A BETTER FUTURE.
          </h2>
        </div>

        <div class="intro-copy">
          <p class="section-description">
            At South-Pacific Engineering Ltd, our mission is to
            deliver integrated engineering excellence across Civil,
            Mechanical and Refractory Engineering, Project Management,
            Facility Management and Safety Management — by providing
            innovative, safe, and sustainable solutions that enhance
            asset value, ensure operational efficiency, and exceed
            client expectations in line with global best practices
            and IFMA Standards.
          </p>

          <a href="/services" class="text-link">
            Explore Our Services <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Our Expertise -->
    <section class="section services">
      <div class="container">
        <p class="section-label">Our Expertise</p>

        <h2 class="section-title">
          ENGINEERING<br>
          ACROSS DISCIPLINES.
        </h2>

        <p class="section-description">
          Our integrated approach brings together engineering,
          project delivery, asset care, and safety management
          to support our clients' operational needs.
        </p>

        <div class="service-grid">
          <article class="service-card">
            <span class="service-number">01</span>
            <h3>Civil Engineering</h3>
            <p>
              Civil engineering solutions supporting infrastructure,
              structural integrity, and built environments.
            </p>
          </article>

          <article class="service-card">
            <span class="service-number">02</span>
            <h3>Mechanical Engineering</h3>
            <p>
              Mechanical engineering support for equipment,
              systems, and operational performance.
            </p>
          </article>

          <article class="service-card">
            <span class="service-number">03</span>
            <h3>Refractory Engineering</h3>
            <p>
              Refractory engineering services supporting the
              protection and performance of high-temperature
              industrial equipment.
            </p>
          </article>

          <article class="service-card">
            <span class="service-number">04</span>
            <h3>Project Management</h3>
            <p>
              Coordinated project planning, execution, and
              oversight to support project objectives.
            </p>
          </article>

          <article class="service-card">
            <span class="service-number">05</span>
            <h3>Facility Management</h3>
            <p>
              Facility management focused on asset value,
              reliability, and operational efficiency.
            </p>
          </article>

          <article class="service-card">
            <span class="service-number">06</span>
            <h3>Safety Management</h3>
            <p>
              Safety-focused management practices that support
              safer work environments and responsible operations.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Our Commitment -->
    <section class="section projects">
      <div class="container">
        <p class="section-label">Our Commitment</p>

        <h2 class="section-title">
          SAFETY. QUALITY.<br>
          SUSTAINABILITY.
        </h2>

        <div class="intro-grid">
          <p class="section-description">
            We are committed to innovative and sustainable solutions
            that help clients protect their assets and improve
            operational performance.
          </p>

          <p class="section-description">
            Our mission emphasizes global best practices and
            alignment with IFMA Standards in delivering facility
            management excellence.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Call to Action -->
    <section class="section contact">
      <div class="container contact-inner">
        <div>
          <p class="section-label">Let's Work Together</p>

          <h2 class="section-title">
            YOUR PROJECT.<br>
            OUR EXPERTISE.
          </h2>

          <p class="section-description">
            Connect with our team to discuss your engineering,
            project management, facility management, or safety needs.
          </p>
        </div>

        <a href="/contact#quote" class="btn btn-primary">
          Discuss Your Project <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>

</body>
</html>
